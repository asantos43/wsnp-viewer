{
  "name": "wsnp-viewer",
  "private": true,
  "version": "0.0.0",
  "description": "Viewer for WSNP (.wsnp) web page snapshots",
  "author": "Anderson Santos",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:electron": "vite build -c vite.electron.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint core electron export prototype e2e src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "prototype": "npm run build:electron && electron . --experiments",
    "package:linux": "npm run build && electron-builder --linux deb rpm --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "build:ui": "vite build",
    "build": "npm run build:ui && npm run build:electron",
    "app": "npm run build && electron ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "allotment": "^1.20.5",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.86.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "homepage": "https://github.com/asantos43/wsnp-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asantos43/wsnp-viewer.git"
  },
  "build": {
    "appId": "io.github.asantos43.wsnp-viewer",
    "productName": "WSNP Viewer",
    "copyright": "Copyright (c) 2026 Anderson Santos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "artifactName": "wsnp-viewer-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "WSNP Viewer <noreply@github.com>",
      "synopsis": "Viewer for WSNP web page snapshots"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}
